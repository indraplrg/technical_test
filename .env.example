APP_NAME=student-management
APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=student_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC

CORS_ALLOWED_ORIGIN=*

READ_TIMEOUT=10
WRITE_TIMEOUT=10
IDLE_TIMEOUT=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20